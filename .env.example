# RHYTHM Phase 5 - SANDBOX ONLY. Do not commit actual credentials.
DATABASE_URL="postgresql://SESSION_USERNAME:ENCODED_PASSWORD@SESSION_HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://SESSION_USERNAME:ENCODED_PASSWORD@SESSION_HOST:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLIC_PUBLISHABLE_KEY"
AUTH_GATE_SECRET="YOUR_GENERATED_64_CHARACTER_HEX_SECRET"
# OPTIONAL: For customer order emails, configure same dedicated Gmail account
# already used for Supabase SMTP. Must be a Google App Password, not login password.
# This app password remains server-side, never NEXT_PUBLIC_ and never committed.
# If omitted, orders still succeed and email status is NOT_CONFIGURED.
# ORDER_SMTP_FROM="your-dedicated-sender@gmail.com"
# ORDER_SMTP_APP_PASSWORD="YOUR_GOOGLE_APP_PASSWORD"

# Optional public origin for the link to order history in transactional emails.
# Set to http://localhost:3000 for local previews, or your deployed demo origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# This must match the verified login email AND User.role=ADMIN in the database.
ADMIN_EMAILS="admin@example.com"
