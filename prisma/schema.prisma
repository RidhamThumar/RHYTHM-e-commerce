generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}
enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PaymentProvider {
  STRIPE
  RAZORPAY
  DEMO
}
enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id String @id @default(cuid())
  email String @unique
  supabaseAuthId String? @unique // Bind store data to Supabase immutable user identity
  name String?
  passwordHash String?
  emailVerifiedAt DateTime?
  role UserRole @default(CUSTOMER)
  addresses Address[]
  cart Cart?
  wishlist WishlistItem[]
  orders Order[]
  verificationTokens VerificationToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String // email_verification | password_reset
  tokenHash String @unique // NEVER store plaintext OTPs
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([userId, purpose, expiresAt])
}

model Address {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient String
  line1 String
  line2 String?
  city String
  region String?
  postalCode String
  countryCode String @db.VarChar(2)
  phone String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @db.Text
  category String
  color String
  currency String @default("USD") @db.VarChar(3)
  priceCents Int // integer minor units; no floating-point money math
  image String @db.Text
  secondaryImage String? @db.Text
  tag String?
  featured Boolean @default(false)
  active Boolean @default(true)
  variants ProductVariant[]
  wishlistItems WishlistItem[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, category])
  @@index([featured, active])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku String @unique
  size String
  stock Int @default(0)
  reserved Int @default(0)
  cartItems CartItem[]
  orderItems OrderItem[]
  @@unique([productId, size])
  @@index([productId])
}

model Cart {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int
  @@unique([cartId, variantId])
}

model WishlistItem {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  checkoutKey String? @unique // protects repeat sandbox submissions
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  email String
  status OrderStatus @default(PENDING)
  currency String @db.VarChar(3)
  subtotalCents Int
  discountCents Int @default(0)
  shippingCents Int @default(0)
  taxCents Int @default(0)
  totalCents Int
  shippingAddress Json // immutable order-time snapshot, including guest checkout
  billingAddress Json?
  items OrderItem[]
  payments Payment[]
  couponCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku String
  productName String
  size String
  quantity Int
  unitPriceCents Int // immutable purchase-time price
  lineTotalCents Int
  @@index([orderId])
}

model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider PaymentProvider
  providerPaymentId String? @unique
  providerOrderId String?
  status PaymentStatus @default(PENDING)
  amountCents Int
  currency String @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
}

model PaymentWebhookEvent {
  id String @id @default(cuid())
  provider PaymentProvider
  providerEventId String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@unique([provider, providerEventId]) // idempotent payment webhooks
}

model Coupon {
  id String @id @default(cuid())
  code String @unique
  discountType DiscountType
  amount Int // percentage as whole percent or fixed minor currency units
  currency String? @db.VarChar(3)
  startsAt DateTime?
  expiresAt DateTime?
  usageLimit Int?
  usageCount Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
}


// Password-verified, email-code second step. Does not store passwords or auth tokens.
model EmailLoginChallenge {
  id String @id @default(cuid())
  email String
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSentAt DateTime @default(now())
  attempts Int @default(0)
  consumedAt DateTime?
  @@index([email, createdAt])
  @@index([expiresAt])
}

// Outcome of transactional order emails; never claim an email was sent when SMTP is unavailable.
model OrderNotification {
  id String @id @default(cuid())
  orderId String
  event String // CONFIRMATION | REFUND
  status String @default("PENDING") // PENDING | SENT | FAILED | NOT_CONFIGURED
  errorMessage String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@unique([orderId, event])
}
